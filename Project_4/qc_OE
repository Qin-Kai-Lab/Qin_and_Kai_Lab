library(Seurat)
library(dplyr)
library(ggplot2)
library(gridExtra)
library(clustree)
library(DoubletFinder)

# set the working directory after cleaning the memory
setwd("C:/Users/yeimy/Box/Project4, Qin hippo/Cell_Ranger")

#load the data 
OE = Read10X(data.dir = "../Cell_Ranger/EO/filtered_feature_bc_matrix")
 
# Create a Seurat Object 
RNA_OE = CreateSeuratObject(counts = OE$`Gene Expression`)
RNA_OE$group = "OE"

rm(OE)

RNA_OE[["percent.mt"]] <- PercentageFeatureSet(RNA_OE, pattern = "^mt-")
RNA_OE

VlnPlot(RNA_OE, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)

# percentiles  5%
nfeature_data <- RNA_OE@meta.data$nFeature_RNA
q0.05_nfeaturef <- quantile(nfeature_data, 0.05)

ncount_data <- RNA_OE@meta.data$nCount_RNA
q0.05_ncount <- quantile(ncount_data, 0.05)


# filtering 
rnaoeFiltr<- subset(RNA_OE, subset = nFeature_RNA > 200 & nCount_RNA > 400 & percent.mt < 5)
rnaoeFiltr

VlnPlot(rnaoeFiltr, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)


rnaoeFiltr<-NormalizeData(object = rnaoeFiltr)
rnaoeFiltr<-FindVariableFeatures(object = rnaoeFiltr)
rnaoeFiltr<-ScaleData(object = rnaoeFiltr)
rnaoeFiltr<-RunPCA(object = rnaoeFiltr)
ElbowPlot(rnaoeFiltr, ndims = 50)
rnaoeFiltr<-FindNeighbors(object = rnaoeFiltr, dims = 1:40)
rnaoeFiltr<-FindClusters(object = rnaoeFiltr)
rnaoeFiltr<-RunUMAP(object = rnaoeFiltr, dims = 1:40)

# pk
sweep.res.list_nsclc<- paramSweep(rnaoeFiltr, PCs = 1:40, sct = F)
sweep.stats_nsclc<-summarizeSweep(sweep.res.list_nsclc, GT = F)
bcmvn_nsclc<- find.pK(sweep.stats_nsclc)


# plotting is not nessesary
ggplot(bcmvn_nsclc, aes(pK, BCmetric, group = 1))+
  geom_point() +
  geom_line()
pK<- bcmvn_nsclc %>% filter(BCmetric == max(BCmetric)) %>% select(pK)
pk<-as.numeric(as.character(pK[[1]]))

nExp_poi<-round(0.039*nrow(rnaoeFiltr@meta.data))
annotations<-rnaoeFiltr@meta.data$seurat_clusters
homotypic.pop<-modelHomotypic(annotations)
nExp_poi.adj<- round(nExp_poi*(1-homotypic.pop))


# run doublet finder

rnaoeFiltr<-doubletFinder(rnaoeFiltr, PCs = 1:40,
                             pN=0.25,
                             pK=pk,
                             nExp = nExp_poi.adj,
                             reuse.pANN = F, sct = F)


# check Df classification 
head(rnaoeFiltr)


# continue the andrey protocol

table(rnaoeFiltr@meta.data$DF.classifications_0.25_0.27_135)

rnaoeFiltr@meta.data$CellID<-rownames(rnaoeFiltr@meta.data)

doubletFiltr<-subset(x = rnaoeFiltr, subset = DF.classifications_0.25_0.27_135 == "Singlet")
doubletFiltr

singletCellId<-doubletFiltr@meta.data$CellID
setwd("C:/Users/yeimy/Box/Project4, Qin hippo/YGG analysis")

